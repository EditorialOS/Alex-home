# Alex Home — environment variables
# Copy this file to `.env.local` and paste your real values.
# `.env.local` is gitignored and must NEVER be committed. Never put keys in code.
#
# Get these three from your Supabase project:
#   Supabase dashboard → Project Settings → API

# Project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key (safe to expose to the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role key (SERVER ONLY — full admin access, bypasses RLS).
# Never prefix this with NEXT_PUBLIC_. Not used until the mailbox API (Phase 2).
SUPABASE_SERVICE_ROLE_KEY=
