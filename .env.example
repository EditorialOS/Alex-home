# Alex Home — environment variables
# Copy this file to `.env.local` and paste your real values.
# `.env.local` is gitignored and must NEVER be committed. Never put keys in code.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role key — SERVER ONLY, full admin, bypasses RLS.
# Used by the Mailbox IN endpoint's authenticated insert.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mailbox ---
# Shared secret the engine sends to POST /api/mailbox/in. Requests without it
# are rejected. Generate one with: openssl rand -hex 32
MAILBOX_SHARED_SECRET=
